---
import { getData } from '../i18n/utils';
import Icon from './Icon.astro';
const { lang } = Astro.props;
const { site, ui } = getData(lang);
const t = ui.sections.contact;
const f = ui.form;
---
<section class="section dark" id="contact">
  <div class="container grid-2 contact">
    <div>
      <p class="sticker sticker--light">{t.eyebrow}</p>
      <h2>{t.title}</h2>
      <p class="lead">{t.text}</p>
      <ul class="social">
        {Object.entries(site.social).map(([name, url]) => (
          <li><a href={url as string} target="_blank" rel="noopener"><span class="badge badge--sm"><Icon name={name} /></span>{name}</a></li>
        ))}
      </ul>
    </div>
    <div class="card form-card">
      <form id="contact-form" novalidate data-form-lang={lang} data-min={site.minPhotos}
        data-err-name={f.errors.name} data-err-email={f.errors.email} data-err-instagram={f.errors.instagram}
        data-err-count={f.errors.count} data-err-message={f.errors.message}
        data-sending={f.sending} data-send={f.send}>
        <div class="hp" aria-hidden="true">
          <label>Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>
        <div class="field">
          <label for="f-name">{f.name} <em class="req">{f.required}</em></label>
          <input id="f-name" name="name" type="text" autocomplete="name" maxlength="100" required aria-required="true" aria-describedby="e-name" />
          <p class="field__err" id="e-name" role="alert" hidden></p>
        </div>
        <div class="field">
          <label for="f-email">{f.email} <em class="req">{f.required}</em></label>
          <input id="f-email" name="email" type="email" autocomplete="email" maxlength="200" required aria-required="true" aria-describedby="e-email" />
          <p class="field__err" id="e-email" role="alert" hidden></p>
        </div>
        <div class="field">
          <label for="f-ig">{f.instagram} <em class="req">{f.required}</em></label>
          <input id="f-ig" name="instagram" type="text" maxlength="100" placeholder={f.instagramHint} autocomplete="off" autocapitalize="none" required aria-required="true" aria-describedby="e-instagram" />
          <p class="field__err" id="e-instagram" role="alert" hidden></p>
        </div>
        <label>{f.need}
          <select name="need">
            {f.options.map((o) => <option>{o}</option>)}
          </select>
        </label>
        <div class="field">
          <label for="f-count">{f.count}</label>
          <input id="f-count" name="count" type="number" min={site.minPhotos} inputmode="numeric" aria-describedby="e-count" />
          <p class="field__err" id="e-count" role="alert" hidden></p>
        </div>
        <div class="field">
          <label for="f-msg">{f.message}</label>
          <textarea id="f-msg" name="message" rows="4" maxlength="2000" aria-describedby="e-message"></textarea>
          <p class="field__err" id="e-message" role="alert" hidden></p>
        </div>
        <p class="consent">{f.consent} <a href={site.privacyUrl}>{f.privacy}</a></p>
        <div class="form-error" id="form-error" role="alert" tabindex="-1" hidden>
          <p>{f.sendError}</p>
          <p><a href={site.social.instagram} target="_blank" rel="noopener">{f.fallback}</a></p>
        </div>
        <button class="btn" type="submit">{f.send}</button>
      </form>
      <div class="thanks" id="thanks" tabindex="-1" hidden>
        <h3>{f.thanksTitle}</h3>
        <p>{f.thanksText}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const igRe = /^(@?[A-Za-z0-9._]{1,30}|(https?:\/\/)?(www\.)?instagram\.com\/[A-Za-z0-9._]{1,30}\/?(\?.*)?)$/i;
  const openedAt = Date.now();

  const input = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  const errEl = (n: string) => document.getElementById('e-' + n)!;
  const formError = document.getElementById('form-error')!;
  const submitBtn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

  function check(n: string, ok: boolean, msg: string) {
    const el = input(n);
    const err = errEl(n);
    el.setAttribute('aria-invalid', String(!ok));
    err.textContent = ok ? '' : msg;
    err.hidden = ok;
    return ok;
  }
  const v = {
    name: () => check('name', input('name').value.trim().length > 0, form.dataset.errName!),
    email: () => check('email', emailRe.test(input('email').value.trim()), form.dataset.errEmail!),
    instagram: () => check('instagram', igRe.test(input('instagram').value.trim()), form.dataset.errInstagram!),
    count: () => {
      const val = input('count').value.trim();
      return check('count', val === '' || Number(val) >= Number(form.dataset.min), form.dataset.errCount!);
    },
  };
  (Object.keys(v) as (keyof typeof v)[]).forEach((n) => {
    input(n).addEventListener('blur', v[n]);
    input(n).addEventListener('input', () => input(n).getAttribute('aria-invalid') === 'true' && v[n]());
  });

  const order = ['name', 'email', 'instagram', 'count', 'message'];
  const focusFirstInvalid = () => (form.querySelector('[aria-invalid="true"]') as HTMLElement | null)?.focus();

  // server error code -> field (anything else is a general failure)
  const fieldOf: Record<string, string> = { invalid_name: 'name', invalid_email: 'email', invalid_instagram: 'instagram', invalid_count: 'count', invalid_message: 'message' };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.hidden = true;
    const ok = [v.name(), v.email(), v.instagram(), v.count()];
    if (ok.includes(false)) return focusFirstInvalid();

    submitBtn.disabled = true;
    submitBtn.textContent = form.dataset.sending!;
    const fail = (code?: string) => {
      const field = code && fieldOf[code];
      if (field) {
        check(field, false, form.dataset['err' + field[0].toUpperCase() + field.slice(1)]!);
        focusFirstInvalid();
      } else {
        formError.hidden = false;
        formError.focus();
      }
      submitBtn.disabled = false;
      submitBtn.textContent = form.dataset.send!;
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          name: input('name').value,
          email: input('email').value,
          instagram: input('instagram').value,
          need: (form.elements.namedItem('need') as HTMLSelectElement).value,
          count: input('count').value,
          message: (form.elements.namedItem('message') as HTMLTextAreaElement).value,
          lang: form.dataset.formLang,
          website: input('website').value,
          elapsed: Date.now() - openedAt,
        }),
      });
      const data = await res.json().catch(() => null);
      if (res.ok && data?.ok === true) {
        form.reset();
        order.forEach((n) => { errEl(n).hidden = true; (form.elements.namedItem(n) as HTMLElement).removeAttribute('aria-invalid'); });
        submitBtn.disabled = false;
        submitBtn.textContent = form.dataset.send!;
        form.hidden = true;
        const thanks = document.getElementById('thanks') as HTMLElement;
        thanks.hidden = false;
        thanks.focus();
      } else {
        fail(data?.error);
      }
    } catch {
      fail();
    }
  });
</script>
