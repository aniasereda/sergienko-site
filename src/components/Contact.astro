---
import { getData } from '../i18n/utils';
const { lang } = Astro.props;
const { site, ui } = getData(lang);
const t = ui.sections.contact;
const f = ui.form;
---
<section class="section dark" id="contact">
  <div class="container grid-2 contact">
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.title}</h2>
      <p class="lead">{t.text}</p>
      <ul class="social">
        {Object.entries(site.social).map(([name, url]) => (
          <li><a href={url as string} target="_blank" rel="noopener">{name}</a></li>
        ))}
      </ul>
    </div>
    <div class="card form-card">
      <form id="contact-form" novalidate data-err-email={f.errors.email} data-err-instagram={f.errors.instagram}>
        <label>{f.name}
          <input name="name" type="text" autocomplete="name" />
        </label>
        <div class="field">
          <label for="f-email">{f.email} <em class="req">{f.required}</em></label>
          <input id="f-email" name="email" type="email" autocomplete="email" required aria-required="true" aria-describedby="e-email" />
          <p class="field__err" id="e-email" role="alert" hidden></p>
        </div>
        <div class="field">
          <label for="f-ig">{f.instagram} <em class="req">{f.required}</em></label>
          <input id="f-ig" name="instagram" type="text" placeholder={f.instagramHint} autocomplete="off" autocapitalize="none" required aria-required="true" aria-describedby="e-ig" />
          <p class="field__err" id="e-ig" role="alert" hidden></p>
        </div>
        <label>{f.need}
          <select name="need">
            {f.options.map((o) => <option>{o}</option>)}
          </select>
        </label>
        <label>{f.count}<input name="count" type="number" min={site.minPhotos} inputmode="numeric" /></label>
        <label>{f.message}<textarea name="message" rows="4"></textarea></label>
        <p class="consent">{f.consent} <a href={site.privacyUrl}>{f.privacy}</a></p>
        <button class="btn" type="submit">{f.send}</button>
      </form>
      <div class="thanks" id="thanks" tabindex="-1" hidden>
        <h3>{f.thanksTitle}</h3>
        <p>{f.thanksText}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const igRe = /^(@?[A-Za-z0-9._]{1,30}|(https?:\/\/)?(www\.)?instagram\.com\/[A-Za-z0-9._]{1,30}\/?(\?.*)?)$/i;

  function check(input: HTMLInputElement, err: HTMLElement, ok: boolean, msg: string) {
    input.setAttribute('aria-invalid', String(!ok));
    err.textContent = ok ? '' : msg;
    err.hidden = ok;
    return ok;
  }

  const email = form.elements.namedItem('email') as HTMLInputElement;
  const ig = form.elements.namedItem('instagram') as HTMLInputElement;
  const eEmail = document.getElementById('e-email')!;
  const eIg = document.getElementById('e-ig')!;
  const vEmail = () => check(email, eEmail, emailRe.test(email.value.trim()), form.dataset.errEmail!);
  const vIg = () => check(ig, eIg, igRe.test(ig.value.trim()), form.dataset.errInstagram!);

  email.addEventListener('blur', vEmail);
  ig.addEventListener('blur', vIg);
  email.addEventListener('input', () => email.getAttribute('aria-invalid') === 'true' && vEmail());
  ig.addEventListener('input', () => ig.getAttribute('aria-invalid') === 'true' && vIg());

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const okEmail = vEmail();
    const okIg = vIg();
    if (!okEmail || !okIg) {
      (okEmail ? ig : email).focus();
      return;
    }
    // stub: no backend yet
    form.hidden = true;
    const thanks = document.getElementById('thanks') as HTMLElement;
    thanks.hidden = false;
    thanks.focus();
  });
</script>
