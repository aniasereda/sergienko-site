---
import { getData } from '../i18n/utils';
const { lang } = Astro.props;
const { site, ui } = getData(lang);
const t = ui.contact;
const f = t.form;
---
<section class="section dark" id="contact">
  <div class="container grid-2 contact">
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.title}</h2>
      <p class="lead">{t.text}</p>
      {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
      <ul class="social">
        {Object.entries(site.social).map(([name, url]) => (
          <li><a href={url as string} target="_blank" rel="noopener">{name}</a></li>
        ))}
      </ul>
    </div>
    <div class="card form-card">
      <form id="contact-form">
        <label>{f.name}<input name="name" type="text" autocomplete="name" required /></label>
        <label>{f.contact}<input name="contact" type="text" required /></label>
        <label>{f.need}
          <select name="need">
            {f.options.map((o) => <option>{o}</option>)}
          </select>
        </label>
        <label>{f.count}<input name="count" type="number" min={site.minPhotos} required /></label>
        <label>{f.message}<textarea name="message" rows="4"></textarea></label>
        <p class="consent">{f.consent} <a href={site.privacyUrl}>{f.privacy}</a></p>
        <button class="btn" type="submit">{ui.cta.send}</button>
      </form>
      <div class="thanks" id="thanks" hidden>
        <h3>{f.thanksTitle}</h3>
        <p>{f.thanksText}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    form.hidden = true;
    (document.getElementById('thanks') as HTMLElement).hidden = false;
  });
</script>
