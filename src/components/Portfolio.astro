---
import { getData, markLast } from '../i18n/utils';
import Photo from './Photo.astro';
const { lang } = Astro.props;
const { ui, site, portfolio } = getData(lang);
const t = ui.portfolio;
---
<section class="section" id="portfolio">
  <div class="container">
    <p class="sticker">{t.eyebrow}</p>
    <h2 set:html={markLast(t.title)} />
    <p class="lead">{t.hint}</p>

    {portfolio.beforeAfter.map((p) => (
      <div class="ba" data-ba>
        <Photo src={p.before} alt={`${t.before} ${p.alt}`.trim()} class="ba__img" />
        <div class="ba__after"><Photo src={p.after} alt={`${t.after} ${p.alt}`.trim()} class="ba__img" /></div>
        <span class="ba__tag ba__tag--l">{t.before}</span>
        <span class="ba__tag ba__tag--r">{t.after}</span>
        <div class="ba__line"></div>
        <input type="range" min="0" max="100" value="50" aria-label={`${t.before} / ${t.after}`} />
      </div>
    ))}

    <div class="gallery">
      {portfolio.gallery.map((p) => <Photo src={p.src} alt={p.alt} class="gallery__img" />)}
    </div>
    <p class="center"><a class="btn btn--ghost" href={site.moreWorksUrl}>{ui.cta.more}</a></p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
    const input = el.querySelector('input')!;
    const update = () => el.style.setProperty('--pos', input.value + '%');
    input.addEventListener('input', update);
    update();
  });
</script>
