---
import site from '../content/site.json';
import prices from '../content/prices.json';
const groups = [
  { title: 'Color correction', items: prices.color, cols: 3 },
  { title: 'Skin retouching', items: prices.skin, cols: 2 },
];
---
<section class="section" id="price">
  <div class="container">
    <p class="eyebrow">Prices</p>
    <h2>Prices</h2>
    <p class="lead">{site.pricesIntro}</p>

    {groups.map((g) => (
      <h3 class="group-title">{g.title}</h3>
      <div class={`grid grid--${g.cols}`}>
        {g.items.map((it: any) => (
          <article class="card price-card">
            <h4>{it.name}</h4>
            <p class="price">{it.price}<span> / photo</span></p>
            <p class="muted">{it.lead}</p>
            <ul class="check">{it.included.map((i: string) => <li>{i}</li>)}</ul>
            {it.notIncluded && (
              <>
                <p class="mini">Not included</p>
                <ul class="cross">{it.notIncluded.map((i: string) => <li>{i}</li>)}</ul>
              </>
            )}
          </article>
        ))}
      </div>
    ))}

    <div class="grid-2 mt">
      <div class="card">
        <h3>What affects the final price</h3>
        <ul class="list">{site.priceFactors.map((f) => <li>{f}</li>)}</ul>
      </div>
      <div class="card">
        <h3>Packages: color + skin</h3>
        <p class="muted">{prices.packageNote}</p>
        <a class="btn" href="#contact">Send photos for a quote</a>
      </div>
    </div>
  </div>
</section>
