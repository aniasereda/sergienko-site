---
import { getData } from '../i18n/utils';
const { lang } = Astro.props;
const { ui, prices } = getData(lang);
const t = ui.sections.prices;
const groups = [
  { title: t.color, items: prices.color, cols: 3 },
  { title: t.skin, items: prices.skin, cols: 2 },
];
---
<section class="section" id="price">
  <div class="container">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2>{t.title}</h2>

    {groups.map((g) => (
      <>
        <h3 class="group-title">{g.title}</h3>
        <div class={`grid grid--${g.cols}`}>
          {g.items.map((it) => (
            <article class="card price-card">
              <h4>{it.name}</h4>
              <p class="price">{it.price}<span> {t.perPhoto}</span></p>
              <p class="muted">{it.text}</p>
            </article>
          ))}
        </div>
      </>
    ))}

    <div class="fine">
      <p>{prices.factors}</p>
      <p>{prices.note}</p>
    </div>
  </div>
</section>
