---
import { getData, paths } from '../i18n/utils';
const { lang } = Astro.props;
const { site, ui } = getData(lang);
---
<header class="header">
  <div class="container header__in">
    <a class="brand" href="#top">{site.name}</a>
    <nav class="nav">
      <a href="#price">{ui.nav.prices}</a>
      <a href="#process">{ui.nav.process}</a>
      <a href="#portfolio">{ui.nav.portfolio}</a>
      <a href="#faq">{ui.nav.faq}</a>
    </nav>
    <div class="lang">
      {(['en', 'uk'] as const).map((l) => (
        <a href={paths[l]} lang={l} hreflang={l} aria-current={l === lang ? 'page' : undefined}>{ui.switcher[l]}</a>
      ))}
    </div>
    <a class="btn btn--sm" href="#contact">{ui.cta.sendPhotos}</a>
  </div>
</header>
