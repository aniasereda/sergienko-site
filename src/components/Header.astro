---
import { getData, paths } from '../i18n/utils';
import Icon from './Icon.astro';
const { lang } = Astro.props;
const { site, ui } = getData(lang);
const sw = ui.langSwitcher;
---
<header class="header">
  <div class="container header__in">
    <a class="brand" href="#top">{site.name}</a>
    <nav class="nav">
      <a href="#price">{ui.nav.prices}</a>
      <a href="#terms">{ui.nav.terms}</a>
      <a href="#booking">{ui.nav.booking}</a>
      <a href="#start">{ui.nav.start}</a>
    </nav>
    <nav class="nav-m" aria-label={ui.nav.prices}>
      <a href="#price">{ui.navMobile.prices}</a>
      <a href="#booking"><span class="nav-m__full">{ui.navMobile.booking}</span><span class="nav-m__short">{ui.navMobile.bookingShort}</span></a>
      <a href="#portfolio">{ui.navMobile.portfolio}</a>
    </nav>
    <div class="lang" data-lang>
      <button class="lang__btn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="lang-menu" aria-label={`${sw.label}: ${sw[lang]}`}>
        <span>{lang.toUpperCase()}</span><i aria-hidden="true"></i>
      </button>
      <ul class="lang__menu" id="lang-menu" hidden>
        {(['en', 'uk'] as const).map((l) => (
          <li>
            <a href={paths[l]} lang={l} hreflang={l} aria-current={l === lang ? 'true' : undefined}>
              <span>{sw[l]}</span>
              {l === lang && <b><Icon name="check" /></b>}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <a class="btn btn--sm" href="#contact">{ui.cta.request}</a>
  </div>
</header>

<script>
  // mark the nav link of the section currently in view
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.nav a, .nav-m a')];
  const byId = new Map<string, HTMLAnchorElement[]>();
  navLinks.forEach((a) => byId.set(a.hash.slice(1), [...(byId.get(a.hash.slice(1)) ?? []), a]));
  const spy = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      navLinks.forEach((a) => a.removeAttribute('aria-current'));
      byId.get(e.target.id)?.forEach((a) => a.setAttribute('aria-current', 'true'));
    });
  }, { rootMargin: '-40% 0px -55% 0px' });
  byId.forEach((_, id) => { const el = document.getElementById(id); if (el) spy.observe(el); });

  document.querySelectorAll<HTMLElement>('[data-lang]').forEach((root) => {
    const btn = root.querySelector('button')!;
    const menu = root.querySelector<HTMLElement>('.lang__menu')!;
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };
    btn.addEventListener('click', () => set(menu.hidden));
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) set(false);
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        set(false);
        btn.focus();
      }
    });
    root.addEventListener('focusout', (e) => {
      if (!root.contains((e as FocusEvent).relatedTarget as Node | null)) set(false);
    });
    // keep the current section when switching language
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => { a.hash = location.hash; })
    );
  });
</script>
