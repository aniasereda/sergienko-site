---
import { getData, markLast } from '../i18n/utils';
import Icon from './Icon.astro';
const { lang } = Astro.props;
const { ui, steps } = getData(lang);
const t = ui.sections.start;
const icons = ['message', 'image', 'check', 'wallet', 'gift'];
---
<section class="section" id="start">
  <div class="container">
    <p class="sticker">{t.eyebrow}</p>
    <h2 set:html={markLast(t.title)} />
    <ol class="start">
      {steps.map((s, i) => (
        <li>
          <span class="badge"><Icon name={icons[i] ?? 'check'} /><i class="badge__n">{i + 1}</i></span>
          <div>
            <h4>{s.title}</h4>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
