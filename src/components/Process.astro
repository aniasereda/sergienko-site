---
import { getData } from '../i18n/utils';
const { lang } = Astro.props;
const { site, ui, steps } = getData(lang);
const t = ui.process;
---
<section class="section dark" id="process">
  <div class="container">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2>{t.title}</h2>
    <p class="lead">{t.intro}</p>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
          <h4>{s.title}</h4>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
    <div class="grid-2 mt">
      <div class="box"><h4>{t.terms}</h4><p>{site.terms}</p></div>
      <div class="box"><h4>{t.important}</h4><p>{site.important}</p></div>
    </div>
  </div>
</section>
