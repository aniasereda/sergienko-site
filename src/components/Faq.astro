---
import { getData } from '../i18n/utils';
const { lang } = Astro.props;
const { ui, faq } = getData(lang);
---
<section class="section" id="faq">
  <div class="container faq">
    <p class="eyebrow">{ui.faq.eyebrow}</p>
    <h2>{ui.faq.title}</h2>
    <div class="acc">
      {faq.map((f, i) => (
        <div class="acc__item">
          <h3>
            <button class="acc__btn" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-${i}`} id={`faq-b-${i}`}>
              <span>{f.q}</span><i aria-hidden="true"></i>
            </button>
          </h3>
          <div class="acc__panel" id={`faq-${i}`} role="region" aria-labelledby={`faq-b-${i}`} hidden={i !== 0}>
            <p>{f.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.acc__btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      document.getElementById(btn.getAttribute('aria-controls')!)!.hidden = open;
    });
  });
</script>
