---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Portfolio from './Portfolio.astro';
import Prices from './Prices.astro';
import Terms from './Terms.astro';
import Booking from './Booking.astro';
import Start from './Start.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
const { lang } = Astro.props;
---
<Base lang={lang}>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Portfolio lang={lang} />
    <Prices lang={lang} />
    <Terms lang={lang} />
    <Booking lang={lang} />
    <Start lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
