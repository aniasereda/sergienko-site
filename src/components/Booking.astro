---
import fs from 'node:fs';
import path from 'node:path';
import { getData } from '../i18n/utils';
const { lang } = Astro.props;
const { ui, site, booking } = getData(lang);
const t = ui.sections.booking;
const imp = booking.important;
const hasBanner = fs.existsSync(path.join(process.cwd(), 'public/images/booking.jpg'));
// the word "Direct" / "DM" in the call to action links to Instagram
const ctaParts = imp.cta.split(/(Direct|DM)/);
---
<section class="section" id="booking">
  <div class="container">
    <div class={`banner${hasBanner ? '' : ' banner--ph'}`}>
      {hasBanner && <img src="/images/booking.jpg" alt="" class="banner__img" loading="lazy" />}
      <div class="banner__in">
        <h2>{t.title}</h2>
        <p class="banner__sub">{booking.subtitle}</p>
      </div>
    </div>

    <ol class="steps3">
      {booking.steps.map((s, i) => (
        <li class="steps3__item">
          <span class="steps3__n" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="important">
      <h3>{imp.title}</h3>
      <p>{imp.text}</p>
      <p class="important__warn">{imp.warning}</p>
      <p class="important__cta">
        {ctaParts.map((part, i) =>
          i % 2 === 1
            ? <a href={site.social.instagram} target="_blank" rel="noopener">{part}</a>
            : part)}
      </p>
    </div>
  </div>
</section>
