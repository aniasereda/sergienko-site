---
import { getData } from '../i18n/utils';
import { loadPortfolio } from '../lib/photos';
import Icon from './Icon.astro';
const { lang } = Astro.props;
const { site, ui } = getData(lang);
const tiles = (await loadPortfolio()).slice(0, 6);
const cols = [0, 1, 2].map((c) => tiles.slice(c * 2, c * 2 + 2));
const dirIcons = ['heart', 'home', 'camera'];
---
<section class="hero" id="top">
  <div class="container hero__in">
    <div class="hero__text">
      <p class="sticker">{site.role}</p>
      <h1>{site.name}</h1>
      <p class="hero__tag">{site.tagline.join(' ')}</p>
      <ul class="dirs">
        {site.directions.map((d, i) => (
          <li><span class="badge"><Icon name={dirIcons[i] ?? 'camera'} /></span>{d}</li>
        ))}
      </ul>
      <div class="btns">
        <a class="btn" href="#contact">{ui.cta.request}</a>
        <a class="btn btn--ghost" href="#price">{ui.cta.prices}</a>
      </div>
    </div>
    {tiles.length > 0 && (
      <div class="collage">
        {cols.map((col) => (
          <div class="collage__col">
            {col.map((p) => <img class="collage__img" src={p.thumb.src} width={p.thumb.width} height={p.thumb.height} alt="" loading="lazy" decoding="async" />)}
          </div>
        ))}
      </div>
    )}
  </div>
</section>
