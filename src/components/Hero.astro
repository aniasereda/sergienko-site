---
import { getData } from '../i18n/utils';
import { loadFeatured } from '../lib/photos';
const { lang } = Astro.props;
const { site, ui } = getData(lang);
const tiles = await loadFeatured();
---
<section class="hero" id="top">
  <div class="hero__band">
    <div class="container">
      <h1>{site.name}</h1>
      <p class="hero__role">{site.role}</p>
    </div>
  </div>

  {tiles.length > 0 && (
    <div class="container hero__photos">
      {tiles.map((p, i) => (
        <img
          src={p.tile.src} srcset={p.tile.srcset} sizes="(min-width: 901px) 180px, 30vw"
          width={p.tile.width} height={p.tile.height} alt=""
          loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i < 3 ? 'high' : undefined} decoding="async"
        />
      ))}
    </div>
  )}

  <div class="container hero__bottom">
    <p class="hero__tag">{site.tagline.map((l) => <span>{l}</span>)}</p>
    <div class="hero__btns">
      <a class="btn" href="#price">{ui.cta.prices}</a>
      <a class="btn btn--ghost" href="#contact">{ui.cta.request}</a>
    </div>
    <p class="hero__dirs">{site.directions.join(' · ')}</p>
  </div>
</section>
