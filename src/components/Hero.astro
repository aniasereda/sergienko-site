---
import { getData } from '../i18n/utils';
import Photo from './Photo.astro';
const { lang } = Astro.props;
const { site, ui, portfolio } = getData(lang);
const g = portfolio.gallery;
const tiles = Array.from({ length: 6 }, (_, i) => g[i % g.length]);
const cols = [0, 1, 2].map((c) => tiles.slice(c * 2, c * 2 + 2));
---
<section class="hero" id="top">
  <div class="container hero__in">
    <div class="hero__text">
      <p class="eyebrow">{site.role}</p>
      <h1>{site.name}</h1>
      <p class="hero__tag">{site.tagline.join(' ')}</p>
      <p class="hero__intro">{site.intro}</p>
      <p class="hero__dirs">{site.directions.join(' · ')}</p>
      <div class="btns">
        <a class="btn" href="#price">{ui.cta.prices}</a>
        <a class="btn btn--ghost" href="#contact">{ui.cta.request}</a>
      </div>
    </div>
    <div class="collage">
      {cols.map((col) => (
        <div class="collage__col">
          {col.map((p) => <Photo src={p.src} alt={p.alt} class="collage__img" />)}
        </div>
      ))}
    </div>
  </div>
</section>
