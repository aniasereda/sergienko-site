---
import '../styles/global.css';
import { getData, paths } from '../i18n/utils';
const { lang = 'en', noindex = false } = Astro.props;
const { ui } = getData(lang);
const ogImage = new URL('/og.jpg', Astro.site).href;
// each page points to itself (canonical) and to its twin in the other language (hreflang)
const twins = /privacy-policy\/?$/.test(Astro.url.pathname)
  ? { en: '/privacy-policy/', uk: '/uk/privacy-policy/' }
  : paths;
const url = (l: string) => new URL(twins[l as 'en' | 'uk'], Astro.site).href;
---
<!doctype html>
<html lang={ui.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={ui.meta.description} />
    <title>{ui.meta.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="vikaretoucher.win" />
    <meta property="og:title" content={ui.meta.title} />
    <meta property="og:description" content={ui.meta.description} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:locale" content={lang === 'uk' ? 'uk_UA' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url(lang)} />
    <link rel="alternate" hreflang="en" href={url('en')} />
    <link rel="alternate" hreflang="uk" href={url('uk')} />
    <link rel="alternate" hreflang="x-default" href={url('en')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Onest:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
