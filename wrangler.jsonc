{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sergienko-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-09",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
